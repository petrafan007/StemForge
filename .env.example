# StemForge needs no API keys or accounts: everything runs locally.
#
# Optional overrides for the local GPU server (local-gpu-server/gpu_server.py):
#
# Regex of web origins allowed to call the GPU server (default: localhost / 127.0.0.1 on any port).
# STEMFORGE_ALLOWED_ORIGIN_REGEX="^https?://(localhost|127\.0\.0\.1)(:\d+)?$"
#
# Where Demucs model weights are cached (default: local-gpu-server/models).
# TORCH_HOME="D:\StemForge\local-gpu-server\models"
